# ------------------------------------------------------------------------------
# SUPABASE (Database & Auth - BaaS)
# Lấy tại: https://supabase.com -> Project Settings -> API
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# ------------------------------------------------------------------------------
# GOOGLE GEMINI AI (Sinh đề thi Hoá học)
# Lấy tại: https://aistudio.google.com/app/apikey
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your-gemini-api-key

# ------------------------------------------------------------------------------
# RESEND (Gửi Email nhắc lịch & học phí)
# Lấy tại: https://resend.com/api-keys
# ------------------------------------------------------------------------------
RESEND_API_KEY=your-resend-api-key
EMAIL_FROM="ChemClass <onboarding@resend.dev>"

# ------------------------------------------------------------------------------
# THÔNG TIN TÀI KHOẢN NGÂN HÀNG (Tạo mã VietQR tự động)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_BANK_ID=MB # Mã ngân hàng: VCB, TCB, MB, ACB, VPB, ICB...
NEXT_PUBLIC_ACCOUNT_NO=0123456789 # Số tài khoản ngân hàng của giáo viên
NEXT_PUBLIC_ACCOUNT_NAME=NGUYEN VAN A # Tên chủ tài khoản (không dấu)
